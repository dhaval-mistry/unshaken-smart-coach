{
	admin off
	auto_https disable_redirects
	skip_install_trust
	# Reverse-proxy error records may contain the callback URI.
	log default {
		exclude http.log.error
	}
}

https://localhost:8443 {
	tls internal

	header {
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	@auth path /api/v1/auth/google/start /api/v1/auth/google/callback /api/v1/auth/session /api/v1/auth/onboarding /api/v1/auth/logout
	handle @auth {
		reverse_proxy 127.0.0.1:8000
	}

	@ui path / /auth/complete /auth/error
	handle @ui {
		root * /srv
		rewrite * /index.html
		file_server
	}

	handle /verify.js {
		root * /srv
		file_server
	}

	handle {
		respond 404
	}
}
