# Deny by default so new local files, credentials, tests and build output cannot
# silently enter the image build context. Keep this allowlist synchronized with
# the Dockerfile's explicit COPY instructions.
**
!Dockerfile
!pyproject.toml
!uv.lock
!alembic.ini
!app/
!app/**/
!app/*.py
!app/**/*.py
!migrations/
!migrations/**/
!migrations/*.py
!migrations/**/*.py
!migrations/*.mako
!migrations/**/*.mako
!migrations/*.sql
!migrations/**/*.sql

# Directory exceptions above permit traversal. Re-exclude host-generated and
# private artifacts after every allowance so they always win by last match.
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.private*
**/private.*
**/*credential*
**/*secret*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.log
**/*.tmp
**/*.temp
**/*~
**/.DS_Store
**/Thumbs.db
