# Safe configuration template only. Never put real passwords or API keys here.
# Copy this file to .env and place personal development secrets in .env.

# Local PostgreSQL development settings
POSTGRES_DB=unshaken_smart_coach
POSTGRES_USER=unshaken
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
EXERCISE_DB_BASE_URL=https://exercisedb.p.rapidapi.com
EXERCISE_DB_HOST=exercisedb.p.rapidapi.com
# Keep this placeholder in .env.example; replace it only in your local .env.
EXERCISE_DB_API_KEY=<<YOUR_EXERCISE_DB_API_KEY>>
EXERCISE_DB_MEDIA_ENABLED=true
DATABASE_URL=<<YOUR_DATABASE_URL>>
# Compose maps only this private, container-network URL into the backend. Use
# hostname postgres and percent-encode reserved characters in credentials.
BACKEND_CONTAINER_DATABASE_URL=postgresql://APP_USER:ENCODED_PASSWORD@postgres:5432/APP_DATABASE
BACKEND_PORT=8000
# Container telemetry is independent of the host setting below and defaults off.
BACKEND_CONTAINER_OTEL_SDK_DISABLED=true
BACKEND_CONTAINER_OTEL_ENDPOINT=http://alloy:4318
# Set this to the reviewed source commit when recording an image as evidence.
BACKEND_SOURCE_COMMIT=local-uncommitted
FRONTEND_API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
DEVELOPMENT_USER_ID=00000000-0000-4000-8000-000000000001
DEVELOPMENT_USER_EMAIL=<<YOUR_DEVELOPMENT_USER_EMAIL>>
DEVELOPMENT_USER_DISPLAY_NAME=Local User

# Set these only in the private root .env before starting Grafana.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# Optional loopback port overrides for local conflicts.
GRAFANA_PORT=3000
ALLOY_OTLP_PORT=4318

# Optional shared Python telemetry settings; use the Compose service address
# instead when the Python process runs inside the Compose network.
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
